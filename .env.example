# Select google-ai-studio (default) or openrouter.
VEYRIN_AI_PROVIDER=google-ai-studio

# Required when VEYRIN_AI_PROVIDER=google-ai-studio. Keep values server-side.
GEMINI_API_KEY=
GEMINI_MODEL=

# Required when VEYRIN_AI_PROVIDER=openrouter. Keep values server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional local development port (defaults to 3000).
PORT=3000
